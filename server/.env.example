# Dream Decoder backend environment.
#
# Copy this file to server/.env and fill in the values locally.
# server/.env is git-ignored. Commit only this blank example.
#
#   cp server/.env.example server/.env
#
# Never paste a real key into a chat, an issue, a screenshot, a commit,
# or the mobile app's EXPO_PUBLIC_* variables.

# --- OpenRouter (the only place a provider secret belongs) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Exact model IDs from the current OpenRouter catalog. Pick them yourself:
# the analysis model must accept text and support structured JSON outputs,
# and the transcription model is a separate choice that must accept the audio
# format this app records. No model is assumed to do both.
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_TRANSCRIPTION_MODEL=

# Set to "off" if your analysis model cannot do structured JSON outputs.
# The server then asks for JSON in the prompt instead and validates the
# response exactly as strictly. Leave unset for strict schema mode.
OPENROUTER_STRUCTURED_OUTPUTS=

# Comma-separated allowlist of model IDs a client may request.
# Leave empty to allow only the two models configured above.
OPENROUTER_ALLOWED_MODELS=

# --- This backend ---
PORT=3000
HOST=0.0.0.0

# Shared bearer token the mobile app must send to THIS server.
# Required: the server refuses to start without it, because it binds to the
# local network so a phone can reach it. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Put the same value in the app's .env as EXPO_PUBLIC_API_AUTH_TOKEN.
# This is a development-grade access gate, not per-user authentication.
API_AUTH_TOKEN=

# Optional attribution headers OpenRouter accepts.
OPENROUTER_APP_TITLE=Dream Decoder
OPENROUTER_SITE_URL=

# Set to 1 to log transcript lengths and timings. Full dream text is never
# logged at any level.
VERBOSE_LOGS=0
