{
  "expo": {
    "name": "Kids Times Tables",
    "slug": "kids-times-tables",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8F5EF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Kids Times Tables to use the microphone so you can say your answers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F5EF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Kids Times Tables to use the microphone so you can say your answers.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ]
  }
}
