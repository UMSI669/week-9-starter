{
  "expo": {
    "name": "Voice Expense",
    "slug": "voice-expense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.voiceexpense.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Voice Expense to turn spoken expenses into text.",
        "NSMicrophoneUsageDescription": "Allow Voice Expense to hear an expense while you record."
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Voice Expense to hear an expense while you record.",
          "speechRecognitionPermission": "Allow Voice Expense to turn spoken expenses into text."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "532d5f59-2398-44c4-b97c-e986f9001774"
      }
    },
    "owner": "deoxc"
  }
}
