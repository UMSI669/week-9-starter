# Dream Decoder — Expo app environment (client side)
#
# The mobile app stores ONLY the URL of your own Dream Decoder backend.
# Never put an OpenRouter key here: every EXPO_PUBLIC_* value is compiled
# into the distributed app bundle and is readable by anyone who has it.
# The OpenRouter key belongs in server/.env (see server/.env.example).
#
# A physical phone cannot reach your computer at "localhost" — localhost is
# the phone itself. Use your development computer's LAN address.
# The address below is an illustration, not your actual address.

EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:3000

# Shared bearer token that the app sends to YOUR backend (not to OpenRouter).
# It must match API_AUTH_TOKEN in server/.env. This is a development-grade
# access gate, not user authentication.
EXPO_PUBLIC_API_AUTH_TOKEN=
